#!/bin/bash
# Force official Linux Chrome through the VA-API -> V4L2-stateless bridge.
# RK3588 panthor is a platform DRM device; Chrome only auto-picks PCI nodes.
#
# GL stack (verified 2026-09-02 on the Orange Pi 5, KDE Wayland session):
# the ONLY combination that initializes a GL context cleanly is
#   --ozone-platform=wayland --use-gl=angle --use-angle=gles
#   --disable-features=Vulkan
# Anything else renders blank pages:
#   - --ozone-platform=x11 or --ozone-platform-hint=auto: ANGLE fails with
#     "Could not create a backing OpenGL context" (error 12289), pages never
#     paint (YouTube stays "Loading...", local video shows a black frame).
#   - Vulkan on: Chrome logs "'--ozone-platform=wayland' is not compatible
#     with Vulkan" and falls into the broken path above.
# With the flags above: zero ANGLE errors, and chrome://media-internals
# reports kVideoDecoderName=VaapiVideoDecoder / kIsPlatformVideoDecode=true
# for 1080p H.264 (the v4l2stateless driver logs "capture mmap idx=" per
# decoded VPU buffer when V4L2SL_DEBUG is set).
#
# Zero-copy GL display path WORKS since 2026-09-03 (GBM display surfaces):
# the driver exports every Chrome-visible surface as a driver-owned linear
# GBM bo (single-object NV12 dmabuf - the shape Chromium requires), while
# the VPU/CMA buffers stay in the kernel (EXPBUF chip-bug ban untouched).
# The default AcceleratedVideoDecodeLinuxZeroCopyGL path then imports every
# frame successfully: hardware decode AND a visible picture, zero
# eglCreateImage errors (verified live 1080p).
#
# Do NOT disable ZeroCopyGL: that pushes VaapiVideoDecoder into the
# ImageProcessor output path, which does not exist on this platform, and
# Chrome silently drops to FFmpeg software for the whole session.
set -u
export LIBVA_DRIVER_NAME="${LIBVA_DRIVER_NAME:-v4l2stateless}"

RENDER_NODE="${CHROME_RENDER_NODE:-/dev/dri/renderD128}"
CHROME_REAL="${CHROME_REAL:-/opt/google/chrome/google-chrome}"
if [[ ! -x "$CHROME_REAL" ]]; then
  echo "google-chrome-vaapi: missing $CHROME_REAL" >&2
  exit 127
fi

args=()
has_render_override=0
has_hw_device=0
has_ignore_blocklist=0
has_disable_gpu_sandbox=0
has_ozone=0
has_gl=0
has_disable_features=0
for a in "$@"; do
  case "$a" in
    --render-node-override|--render-node-override=*) has_render_override=1 ;;
    --hardware-video-device-path|--hardware-video-device-path=*) has_hw_device=1 ;;
    --ignore-gpu-blocklist) has_ignore_blocklist=1 ;;
    --disable-gpu-sandbox) has_disable_gpu_sandbox=1 ;;
    --ozone-platform=*|--ozone-platform-hint|--ozone-platform-hint=*) has_ozone=1 ;;
    --use-gl=*|--use-angle=*) has_gl=1 ;;
    --disable-features|--disable-features=*) has_disable_features=1 ;;
  esac
done

[[ "$has_render_override" = 0 ]] && args+=(--render-node-override="$RENDER_NODE")
[[ "$has_hw_device" = 0 ]] && args+=(--hardware-video-device-path="$RENDER_NODE")
[[ "$has_ignore_blocklist" = 0 ]] && args+=(--ignore-gpu-blocklist)
[[ "$has_disable_gpu_sandbox" = 0 ]] && args+=(--disable-gpu-sandbox)
# Pure Wayland + ANGLE/GLES with Vulkan off (see header comment).
[[ "$has_ozone" = 0 ]] && args+=(--ozone-platform=wayland)
[[ "$has_gl" = 0 ]] && args+=(--use-gl=angle --use-angle=gles)
if [[ "$has_disable_features" = 0 ]]; then
  # Vulkan: Ozone-Wayland has no present path.
  #
  # Hardware video decode RE-ENABLED 2026-09-02: the bridge now exports each
  # decode surface as a driver-owned linear GBM bo (single-object NV12
  # dma-buf; the VPU/CMA buffers are never exported), so the zero-copy GL
  # path's per-frame eglCreateImage succeeds and the picture shows.
  # Verified: VaapiVideoDecoder + non-black canvas + GPU holds rkvdec.
  args+=(--disable-features=Vulkan)
fi

# CPU pinning (2026-09-03): keep Chrome on the 4 big A76 cores.
# RK3588 layout: 0-3 = A55 cluster, 4-5 / 6-7 = two A76 clusters. This
# kernel has no EAS, so the plain scheduler spreads Chrome's frame-deadline
# threads (GPU process, video-tab renderer) evenly onto the A55s too, which
# costs frame pacing (a deadline thread landing on an A55 runs ~2x slower).
# kwin/plasma are deliberately NOT pinned: steady state parks them on the
# now-idle little cores, and compositing bursts can still borrow big cores.
#  - CHROME_PIN_CPUS="4-7" (default); set "0-7" or "" to disable.
#  - If the caller already restricted affinity (e.g. `taskset -c 0-3
#    google-chrome-stable`), respect it and do not override.
PIN_CPUS="${CHROME_PIN_CPUS:-4-7}"
CUR_AFFINITY=$(awk '/^Cpus_allowed_list/ {print $2}' /proc/self/status)
if [[ -n "$PIN_CPUS" && "$PIN_CPUS" != "0-7" && "$CUR_AFFINITY" = "0-7" ]]; then
  exec taskset -c "$PIN_CPUS" "$CHROME_REAL" "${args[@]}" "$@"
fi

exec "$CHROME_REAL" "${args[@]}" "$@"
